node_modules/
dist/
plans/
docs/

# Next-task planning documents (working notes, not committed).
nexttask*.md

# Docs-worker test fixtures live under a node_modules/ (and a dist/) dir on
# purpose — the resolver walks real node_modules layouts. Keep them tracked.
# These negations must come after the ignore rules above to take effect.
!src/workers/__fixtures__/node_modules/
!src/workers/__fixtures__/node_modules/**

# Patched dist copies built by the A/B harnesses (scripts/spec-url-dist.ts).
.ab-dist/

# Measurement pools produced by scripts/extraction-*-step0.ts (large, regenerable).
.measure/

# The shipped-at-BASELINE_REF copy of final-gate.ts that
# scripts/boot-skip-verdict-ab.ts writes next to the real one so the baseline
# arm's relative imports resolve. Created and deleted per run; never committed.
src/task/final-gate.baseline.gen.ts

# Run state written by /task INTO this repo when pi-task is developed on
# itself. Specs, debug logs, and env notes for a run — never source.
.pi-tasks/
