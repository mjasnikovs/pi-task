{
    "name": "@mjasnikovs/pi-task",
    "version": "0.18.12",
    "description": "Deterministic task planning and spec-orchestration for local models — crash-safe /task pipelines with verify/enforce gates, a real-time remote web view, and web/docs/fetch/worker subagent tools.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "assets",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "lint": "prettier --log-level warn --write 'src/**/*.ts' && eslint --fix . && tsc --noEmit",
        "test": "cross-env AGENT=1 bun test --isolate src/",
        "prepublishOnly": "bun run build"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": ">=0.80.0",
        "@earendil-works/pi-agent-core": ">=0.80.0",
        "@earendil-works/pi-tui": ">=0.80.0"
    },
    "dependencies": {
        "@mozilla/readability": "0.6.0",
        "@sinclair/typebox": "0.34.49",
        "linkedom": "0.18.12",
        "qrcode": "1.5.4",
        "turndown": "7.2.4",
        "web-push": "3.6.7",
        "ws": "8.21.0"
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "0.80.2",
        "@earendil-works/pi-coding-agent": "0.80.2",
        "@earendil-works/pi-tui": "0.80.2",
        "@eslint/js": "10.0.1",
        "@types/bun": "1.3.12",
        "@types/qrcode": "1.5.6",
        "@types/turndown": "5.0.6",
        "@types/web-push": "3.6.4",
        "@types/ws": "8.18.1",
        "cross-env": "^10.1.0",
        "eslint": "10.2.1",
        "globals": "17.5.0",
        "prettier": "3.8.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.58.2"
    },
    "keywords": [
        "pi-package",
        "pi",
        "pi-extension",
        "pi-coding-agent",
        "pi.dev",
        "coding-agent",
        "ai-agent",
        "agent",
        "subagent",
        "task-orchestration",
        "spec-orchestration",
        "spec-driven",
        "task-planning",
        "planning",
        "autonomous",
        "local-llm",
        "llm",
        "llama-server",
        "remote",
        "web-view",
        "web-push"
    ],
    "author": "mjasnikovs <mjasnikovs@googlemail.com>",
    "homepage": "https://github.com/mjasnikovs/pi-task#readme",
    "bugs": {
        "url": "https://github.com/mjasnikovs/pi-task/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mjasnikovs/pi-task.git"
    },
    "license": "AGPL-3.0-only",
    "pi": {
        "extensions": [
            "dist/index.js"
        ],
        "image": "https://raw.githubusercontent.com/mjasnikovs/pi-task/main/assets/pipeline.png"
    }
}
